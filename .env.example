# Copy to .env before running `docker compose -f infra/docker-compose.yml up`.

POSTGRES_USER=app_migrator
POSTGRES_PASSWORD=change-me-migrator
POSTGRES_DB=seredina
POSTGRES_PORT=5432

REDIS_PORT=6379

# The app_tenant role is created by prisma/rls/policies.sql at migrate time with this
# password -- it's the only role apps/api and apps/worker ever connect as.
APP_TENANT_DB_PASSWORD=change-me-app-tenant

JWT_SECRET=change-me-to-a-long-random-string

# Encrypts email channel IMAP/SMTP passwords at rest (AES-256-GCM) -- MUST be exactly
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# Losing/rotating this key makes every already-stored email channel password
# undecryptable -- back it up like you would a database password.
ENCRYPTION_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000

# self_hosted | cloud
SEREDINA_MODE=self_hosted

# Optional. Error tracking (apps/api and apps/worker) -- unset means no-op, no
# account needed for local dev. Points at either Sentry.io or a self-hosted
# GlitchTip instance (protocol-compatible with the Sentry SDK) -- your choice,
# doesn't change any code, just where the DSN's host resolves.
SENTRY_DSN=

API_PORT=4000

WEB_PORT=8080
# Must match how the browser reaches each service -- both cross the network boundary
# to the user's machine, so neither can be the in-compose-network hostname (`api`/`web`).
WEB_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:4000
